---
import type { CollectionEntry } from "astro:content";
import Figure from "./Figure.astro";
import TagList from "./TagList.astro";

interface Props {
  project: CollectionEntry<"projects">;
  /** 1-based position in the sorted list; doubles as the figure number. */
  number: number;
}

const { project, number } = Astro.props;
const {
  card,
  repo,
  technicalReadme,
  video,
  cardVideo,
  cardZoom,
  poster,
  image,
  pair,
  alt,
} = project.data;
const href = `/projects/${project.id}`;
---

<li class:list={{ "card-zoom": cardZoom }}>
  <article>
    <Figure
      number={number}
      video={cardVideo ?? video}
      poster={poster}
      image={image}
      {/* A pair normally wins over a single clip, but an explicit
          `cardVideo` is a deliberate choice about what the card shows —
          so it overrides the pair here while the detail page keeps it. */}
      pair={cardVideo ? undefined : pair}
      alt={alt}
      caption={card.caption}
      href={href}
    />
    <div class="project-row">
      <h3 class="project-title"><a href={href}>{card.title}</a></h3>
    </div>
    <p class="project-summary">{card.summary}</p>
    <p class="project-evidence">{card.evidence}</p>
    <TagList tags={card.tags} />
    <div class="project-links">
      <a href={href}>Case study <span aria-hidden="true">&rarr;</span></a>
      {(technicalReadme || repo) && <a href={technicalReadme ?? repo}>Code</a>}
    </div>
  </article>
</li>
