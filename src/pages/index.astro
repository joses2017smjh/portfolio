---
import Base from "../layouts/Base.astro";
import ProjectItem from "../components/ProjectItem.astro";
import Figure from "../components/Figure.astro";
import TagList from "../components/TagList.astro";
import { site } from "../site.config";
import { resume } from "../resume.config";
import { sortedProjects } from "../lib/projects";

const projects = await sortedProjects();
const humanoid = projects.filter((p) => p.data.track === "humanoid");
const rag = projects.filter((p) => p.data.track === "rag");
const vision = projects.filter((p) => p.data.track === "vision");
const coursework = projects.filter((p) => p.data.track === "coursework");
const teleop = projects.find((p) => p.id === "berkeley-humanoid-vr");
if (!teleop) throw new Error("The physical robotics case study is missing.");
// A wrapped timeline line never starts with the " · " separator.
const keepDot = (text: string) => text.replaceAll(" · ", " · ");
// Splits a timeline line around the entry's role so the role renders bold.
const withRole = (text: string, role?: string) => {
  const line = keepDot(text);
  const at = role ? line.indexOf(role) : -1;
  if (!role || at < 0) return [{ text: line, bold: false }];
  return [
    { text: line.slice(0, at), bold: false },
    { text: role, bold: true },
    { text: line.slice(at + role.length), bold: false },
  ];
};
---

<Base title={`${site.name} — Robotics, Computer Vision & AI Software`} description={`${site.positioning} ${site.seeking}`} full demoToggle={false}>
  <div class="portfolio-home">
    <section class="portfolio-hero" id="about" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Jose Sanchez Gonzalez · M.S. Artificial Intelligence</p>
        <h1 id="hero-title">{site.positioning}</h1>
        <p class="hero-role">{site.seeking}</p>
        <p class="hero-intro">See perception drive a pruning arm, VR control a physical humanoid, and measured policy evaluation across simulators. Each case study links the demo to code and results.</p>
        <ul class="link-row hero-actions">
          <li><a class="button-link" href="#projects">Humanoid + hardware</a></li>
          <li><a class="button-link button-secondary" href="#ai-software">RAG & agents</a></li>
          <li><a class="button-link button-secondary" href="#vision-vla">Computer vision & VLA</a></li>
        </ul>
        <div class="hero-resume" id="resume">
          <ul class="link-row resume-downloads">
            <li><a href={resume.links.pdf}>Download résumé <span class="file-type">PDF</span></a></li>
            {resume.links.variants.filter((variant) => variant.href !== resume.links.pdf).map((variant) => (
              <li><a href={variant.href}>{variant.label} <span class="file-type">PDF</span></a></li>
            ))}
          </ul>
          <ul class="link-row resume-downloads">
            <li><a href={resume.links.linkedin}>LinkedIn</a></li>
            <li><a href="https://github.com/joses2017smjh">GitHub</a></li>
            <li><a href={`mailto:${site.email}`}>Get in touch</a></li>
          </ul>
          <p class="meta resume-updated">Résumé updated October 18, 2026</p>
        </div>
      </div>
      <section class="education-overview" id="education" aria-labelledby="background-title">
        <p class="eyebrow">Oregon State University</p>
        <h2 id="background-title">Education & experience</h2>
        <ol class="education-timeline" aria-label="Education and experience timeline">
          {resume.timeline.map((entry) => (
            <li class:list={{ graduation: entry.graduation }}>
              <time datetime={entry.datetime}>{entry.date}</time>
              <div>
                {entry.graduation && <p class="graduation-tag">Graduated</p>}
                <h3>{withRole(entry.title, entry.experience).map((part) => part.bold ? <strong>{part.text}</strong> : part.text)}</h3>
                {entry.focus && <p>{withRole(entry.focus, entry.experience).map((part) => part.bold ? <strong>{part.text}</strong> : part.text)}</p>}
                {entry.roles.length > 0 && (
                  <ul>
                    {entry.roles.map((role) => <li>{keepDot(role)}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    </section>

    <section class="work-section" id="projects" aria-labelledby="work-title">
      <div class="section-heading has-control">
        <div>
          <p class="eyebrow">01 · Robotics & embodied AI</p>
          <h2 id="work-title">Humanoid + Hardware</h2>
        </div>
        <button id="demo-playback" type="button" hidden>Pause demos</button>
      </div>
      <h3 class="project-group-title">Simulation</h3>
      <ul class="project-grid project-grid-three">
        {humanoid.map((project) => <ProjectItem project={project} number={projects.indexOf(project) + 1} />)}
      </ul>
      <section class="hardware-section" id="beyond" aria-labelledby="hardware-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">From simulation to the workshop</p>
            <h3 id="hardware-title">Physical Hardware & AR/VR</h3>
          </div>
        </div>
        <article class="hardware-showcase">
          <div class="hardware-demo">
            <Figure
              number={projects.indexOf(teleop) + 1}
              video={teleop.data.video}
              poster={teleop.data.poster}
              alt={teleop.data.alt}
              caption={teleop.data.card.caption}
            />
            <div class="hardware-dashboard-link">
              <a href="/media/humanoid-vr/operator-dashboard.jpg">Operator panels</a>
              <span aria-hidden="true"> · </span>
              <a href="https://www.linkedin.com/feed/update/urn:li:activity:7511860298836832256/">LinkedIn post</a>
            </div>
          </div>
          <div class="hardware-copy">
            <h4>{teleop.data.card.title}</h4>
            <p class="hardware-intro">{teleop.data.card.summary}</p>
            <p class="project-evidence">{teleop.data.card.evidence}</p>
            <TagList tags={teleop.data.card.tags} />
            <ul class="link-row hardware-actions">
              <li><a class="button-link" href="/projects/berkeley-humanoid-vr">View project</a></li>
              <li><a href={teleop.data.repo}>GitHub</a></li>
              <li><a href="/beyond/humanoid">Build log <span aria-hidden="true">&rarr;</span></a></li>
            </ul>
            <div class="hardware-build-grid">
              <figure>
                <a class="hardware-build-frame" href="/beyond/humanoid">
                  <img src="/media/humanoid/26-fully-built-movement.jpg" alt="Fully assembled Berkeley Humanoid Lite on a support rack, with its arms, legs, and external wiring visible." width="1200" height="1600" loading="lazy" decoding="async" />
                </a>
                <figcaption>The complete physical build.</figcaption>
              </figure>
              <figure>
                <div class="hardware-build-frame">
                  <video controls data-loop loop playsinline muted preload="none" poster="/media/humanoid-vr/supported-leg-motion.jpg" aria-label="Seven-second leg-motion loop with the assembled humanoid supported by a rack.">
                    <source src="/media/humanoid-vr/supported-leg-motion.mp4" type="video/mp4" />
                  </video>
                </div>
                <figcaption>Supported leg-motion test · 7 s · <a href="/media/humanoid-vr/supported-leg-motion.gif">GIF</a></figcaption>
              </figure>
            </div>
          </div>
        </article>
      </section>
    </section>

    <section class="work-section" id="ai-software" aria-labelledby="ai-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 · AI & software engineering</p>
          <h2 id="ai-title">RAG & Agents</h2>
        </div>
      </div>
      <ul class="project-grid">
        {rag.map((project) => <ProjectItem project={project} number={projects.indexOf(project) + 1} />)}
      </ul>
    </section>

    <section class="work-section" id="vision-vla" aria-labelledby="vision-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 · Perception & manipulation</p>
          <h2 id="vision-title">Computer Vision & VLA</h2>
        </div>
      </div>
      <ul class="project-grid project-grid-three">
        {vision.map((project) => <ProjectItem project={project} number={projects.indexOf(project) + 1} />)}
      </ul>
    </section>

    <section class="work-section" id="coursework" aria-labelledby="coursework-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Graduate coursework</p>
          <h2 id="coursework-title">Language and 3D learning</h2>
        </div>
      </div>
      <ul class="supporting-projects">
        {coursework.map((project) => (
          <li>
            <h3><a href={`/projects/${project.id}`}>{project.data.card.title}</a></h3>
            <p>{project.data.card.summary}</p>
            <a href={`/projects/${project.id}`}>Case study <span aria-hidden="true">&rarr;</span></a>
          </li>
        ))}
      </ul>
    </section>

    <section class="contact-block" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">Let's talk</p>
      <h2 id="contact-title">Building robots or AI software?</h2>
      <p>I’m looking for engineering roles in robotics, computer vision, embodied AI, and AI software. Let’s talk about the systems your team is building.</p>
      <a class="contact-address" href={`mailto:${site.email}`}>{site.email}</a>
    </section>
  </div>
</Base>
